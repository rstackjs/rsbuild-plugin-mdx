{
  "name": "@rsbuild/plugin-mdx",
  "version": "1.1.3",
  "homepage": "https://github.com/rstackjs/rsbuild-plugin-mdx#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rsbuild-plugin-mdx/issues"
  },
  "repository": "https://github.com/rstackjs/rsbuild-plugin-mdx",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rs lib",
    "bump": "pnpm version -m \"release: v%s\"",
    "check": "rs check",
    "dev": "rs lib -w",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "rs hooks",
    "test": "rs test"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.2",
    "@rsbuild/plugin-preact": "^2.1.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-svgr": "^2.0.5",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rstackjs/test-utils": "^0.2.0",
    "@rstest/playwright": "^0.11.11",
    "@types/node": "^24.13.3",
    "playwright": "^1.62.1",
    "preact": "^10.29.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rstack": "^0.7.2",
    "typescript": "7.0.2",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
