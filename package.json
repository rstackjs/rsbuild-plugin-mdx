{
  "name": "@rsbuild/plugin-mdx",
  "version": "1.1.3",
  "repository": "https://github.com/rstackjs/rsbuild-plugin-mdx",
  "homepage": "https://github.com/rstackjs/rsbuild-plugin-mdx#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rsbuild-plugin-mdx/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib",
    "dev": "rslib -w",
    "lint": "rslint && prettier -c .",
    "lint:write": "rslint --fix && prettier -w .",
    "prepare": "simple-git-hooks",
    "test": "rstest",
    "bump": "npx bumpp"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:write"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.1",
    "@rsbuild/plugin-preact": "^2.1.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-svgr": "^2.0.5",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.9.0",
    "@rstackjs/test-utils": "^0.2.0",
    "@rstest/core": "^0.11.11",
    "@rstest/playwright": "^0.11.11",
    "@types/node": "^24.13.3",
    "playwright": "^1.62.1",
    "preact": "^10.29.8",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git-hooks": "^2.14.0",
    "typescript": "7.0.2",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
